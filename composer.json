{
  "name": "dynamia-tools/buckie",
  "description": "Buckie PHP — filesystem-native file server with a minimal S3-style REST API. Standalone application.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Buckie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Buckie\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "bin": [
    "bin/buckie"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "suggest": {
    "ext-gd": "Required for on-the-fly thumbnails",
    "ext-imagick": "Alternative thumbnail backend (requires a restrictive policy.xml)"
  },
  "keywords": [
    "file-server",
    "s3",
    "storage",
    "filesystem",
    "rest-api",
    "buckie"
  ],
  "support": {
    "issues": "https://github.com/dynamiatools/buckie-php/issues"
  }
}
